# ============================================================
# QOSID FLOW — environment variable template
# ============================================================
# Copy to `.env` and fill in REAL values. `.env` is git-ignored; this
# template must NEVER contain a real credential.
#
#   cp .env.example .env && chmod 600 .env
#
# Every entry mirrors a `${ENV_VAR:default}` placeholder in
# `app/src/main/resources/application.yml` (gateway) or
# `ops/src/main/resources/application.yml` (ops sidecar).
#
# WHERE A SETTING BELONGS (owner decision, 2026-07-18):
#   * boot-critical (needed before the settings DB can be read) -> .env
#   * request-lifecycle (endpoints, auth, tenant fields)        -> Settings UI / settings DB
# Precedence for the DB-managed keys is: settings-DB row > env var > empty.
# That is why several source/telegram/oauth2 vars below are listed as
# transitional fallbacks only.
#
# In production this file is loaded by the systemd unit via
# `EnvironmentFile=/opt/services/qosid-flow/.env` (0600, owned by the service
# user). The ops sidecar (`ops/qosid-ops.service`) needs its OWN copy of
# SETTINGS_ENCRYPTION_KEY — secrets must round-trip between both JVMs.
# ============================================================


# ------------------------------------------------------------
# Ports & profile
# ------------------------------------------------------------
# Gateway HTTP port (REST /qosid/**). nginx reverse-proxies /qosid/ here.
SERVER_PORT=8090
# Actuator/Prometheus port — keep it OFF the public interface.
MANAGEMENT_PORT=8091
# `dev` enables the TestController test endpoints. It no longer exposes
# /actuator/shutdown (that profile document was removed — the unauthenticated
# management port made it a remote kill switch), but keep prod on `prod`.
SPRING_PROFILES_ACTIVE=prod


# ------------------------------------------------------------
# Upstream API (E3 — where requests are actually sent)
# ------------------------------------------------------------
# SAFETY-RULES rule 22 — the `/b` TRAP. `API_BASE_URL` carries the FULL
# upstream path prefix, INCLUDING `/b`, because client URIs do not.
# qosid-flow strips `/qosid/api/v1/queue` from the client URI and concatenates
# the remainder onto this value:
#   client  /qosid/api/v1/queue/sb/sbr/moderator/product/measure_list:table
#   -> becomes https://app.smartup24.com/b/sb/sbr/moderator/product/measure_list:table
# Putting `/b` in BOTH the client path and here yields `/b/b/...` -> 404.
# Dropping it from here bypasses the upstream prefix entirely -> 404.
API_BASE_URL=https://app.example.com/b


# ------------------------------------------------------------
# Source system (Biruni / Oracle) — E1 pull + E5 save
# ------------------------------------------------------------
# TRANSITIONAL FALLBACK ONLY. Endpoints and outbound auth are configured
# through the Settings UI (settings DB) since B3. Blank base-url or pull-uri
# keeps the pull cycle dormant, which is the correct state for a REST-only
# deployment.
SOURCE_BASE_URL=
SOURCE_PULL_URI=
SOURCE_SAVE_URI=
SOURCE_OAUTH2_PROVIDER_URI=
# Basic-auth fallback for the source channel (B3 `type=basic`).
# A real production credential for this pair was leaked into git history —
# see docs/SECURITY-REMEDIATION.md. Rotate before reuse.
SOURCE_USERNAME=changeme
SOURCE_PASSWORD=changeme
# Source HTTP timeout, seconds.
SOURCE_TIMEOUT=60


# ------------------------------------------------------------
# Kafka / Redpanda (load balancing between pipeline stages)
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_GROUP_ID=gateway-service-group
# Partition count the dynamic-concurrency monitor assumes; must match the
# real topic partition count or scaling decisions are wrong.
KAFKA_PARTITIONS=10
KAFKA_TOPIC_ORACLE_REQUEST=gateway.oracle.request
KAFKA_TOPIC_ORACLE_RESPONSE=gateway.oracle.response
KAFKA_TOPIC_ORACLE_DLQ=gateway.oracle.dlq
KAFKA_TOPIC_API_REQUEST=gateway.api.request
KAFKA_TOPIC_API_RESPONSE=gateway.api.response
KAFKA_TOPIC_API_DLQ=gateway.api.dlq


# ------------------------------------------------------------
# Redis (request state + idempotency lock)
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# How long request state survives; also bounds how long /status works.
REDIS_STATE_TTL_HOURS=72
# Idempotency lock TTL — must exceed the worst-case upstream call duration,
# otherwise a slow request can be processed twice.
REDIS_LOCK_TTL_SECONDS=300


# ------------------------------------------------------------
# Inbound proxy hardening
# ------------------------------------------------------------
# Comma-separated list of proxies allowed to set X-Forwarded-For. If nginx
# terminates TLS on the same host, `127.0.0.1` is correct. Setting this too
# broadly lets a client spoof its own source IP.
TRUSTED_PROXIES=127.0.0.1
# Comma-separated allowlist of hosts accepted in the `X-Callback-Url` header.
# EMPTY means "any PUBLIC host" (private/loopback/link-local are always
# blocked). Prefer an explicit allowlist in production — it is the difference
# between a callback feature and an SSRF-flavoured outbound relay.
CALLBACK_ALLOWED_HOSTS=
# Max NON-multipart request body in bytes; above it the proxy answers 413 instead
# of buffering the bytes on a worker thread. 20971520 (20 MiB) matches the Kafka
# message ceiling, so anything larger already fails at the producer — only raise
# this together with max.request.size / fetch.max.bytes. `0` disables the check.
# BiruniUpload multipart uploads are NOT affected (they keep the 50MB/52MB
# spring.servlet.multipart limits).
PROXY_MAX_BODY_SIZE=20971520
# Adds `Secure` to all four console cookies (JSESSIONID, XSRF-TOKEN, OPS_SESSION,
# OPS-XSRF-TOKEN). MUST stay `false` while the console is served over plain HTTP
# (SSH tunnel) — a browser silently DROPS a Secure cookie on a plain-HTTP
# response, so login breaks with no useful error. Flip to `true` the day
# nginx/TLS fronts the console, and set it in BOTH systemd units
# (gateway-service AND qosid-ops) — the cookies are per-JVM.
COOKIE_SECURE=false


# ------------------------------------------------------------
# Response storage (RocksDB, 7-day retention)
# ------------------------------------------------------------
ROCKSDB_PATH=/opt/services/qosid-flow/data/rocksdb
ROCKSDB_RETENTION_DAYS=7
# Bodies at or under this many bytes are inlined into /status; larger ones
# return a `resultUrl` pointer instead.
RESPONSE_THRESHOLD_SIZE=1024


# ------------------------------------------------------------
# S3 / object storage (BiruniUpload multipart handling)
# ------------------------------------------------------------
S3_ENABLED=false
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_TEMP_BUCKET=qosid-temp
S3_PERMANENT_BUCKET=qosid-permanent
# Presigned-link lifetime, hours.
S3_LINK_EXPIRY=24


# ------------------------------------------------------------
# Settings control-plane (B1) — embedded H2, shared with the ops sidecar
# ------------------------------------------------------------
SETTINGS_DB_PATH=/opt/services/qosid-flow/data/settings
# AES key for secret-typed settings rows. MUST be identical in the gateway
# unit and the ops unit, or stop-to-edit secret writes cannot be decrypted.
# Generate once and store it like a private key:
#   openssl rand -hex 32
# Losing it means every stored secret setting must be re-entered.
SETTINGS_ENCRYPTION_KEY=<openssl rand -hex 32>
# Admin session lifetime, minutes.
ADMIN_SESSION_TTL_MIN=480

# One-shot admin password reset. Leave BOTH unset in steady state.
# ADMIN_PASSWORD_RESET=<new-password>   # reset to this value on next boot
# ADMIN_RESET=true                      # reset to the default `admin`
# After a reset boot, REMOVE the variable. The default admin/admin account
# must be changed on first login.


# ------------------------------------------------------------
# Telegram DLQ alerts
# ------------------------------------------------------------
# TRANSITIONAL FALLBACK ONLY — since v1.x these live in the settings DB
# (bot-token stored AES-encrypted, masked on read). Configure via the
# Telegram tab in the Settings UI; env vars apply only when no DB row exists.
# A real bot token was leaked into git history and the bot was hijacked —
# see docs/SECURITY-REMEDIATION.md. Never put a live token in yaml again.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
TELEGRAM_MESSAGE_THREAD_ID=


# ------------------------------------------------------------
# Observability back-ends (Errors + Statistics admin modules)
# ------------------------------------------------------------
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090


# ------------------------------------------------------------
# Tenant boundary translation (C-faza)
# ------------------------------------------------------------
# Wire field names used on the source boundary. Defaults keep Biruni working.
TENANT_FIELD=company_id
EXTRA_TENANT_FIELD=filial_id
# tenantId used for REST-sourced requests when the auth principal carries none.
DEFAULT_REST_TENANT=0


# ------------------------------------------------------------
# Pull scheduler (E1)
# ------------------------------------------------------------
POLLING_ENABLED=true
POLLING_INTERVAL_MS=5000
POLLING_BATCH_SIZE=100


# ------------------------------------------------------------
# Outbound HTTP client + retry (E3)
# ------------------------------------------------------------
HTTP_CONNECT_TIMEOUT=10000
HTTP_READ_TIMEOUT=30000
HTTP_WRITE_TIMEOUT=30000
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_IDLE_TIME=60000
HTTP_MAX_LIFE_TIME=300000
HTTP_PENDING_ACQUIRE=45000
RETRY_MAX_ATTEMPTS=3
RETRY_INTERVAL_MS=3000
RETRY_STATUSES=408,429,500,502,503,504
# Messages older than this are dropped instead of retried forever. This — not any
# count — is when a CB-blocked message gives up and goes to the DLQ (rule 23).
RETRY_MAX_MESSAGE_AGE=300000
# CB-blocked messages wait in memory for their circuit instead of spinning through
# Kafka: first re-check after RETRY_CB_REQUEUE_DELAY, doubling up to
# RETRY_CB_REQUEUE_MAX_DELAY (one CB open-window). The wait is bounded by memory, in
# both messages and bytes; past either bound the message goes to the DLQ.
RETRY_CB_REQUEUE_DELAY=2000
RETRY_CB_REQUEUE_MAX_DELAY=30000
RETRY_CB_MAX_PENDING=5000
RETRY_CB_MAX_PENDING_BYTES=268435456
# Runaway guard only, NOT a retry policy (rule 23). With the delayed requeue above a
# message needs ~150 requeues at most, so this fires only if the delay path breaks.
# It was 50 until 2026-07-27, when one 30 s circuit window DLQ'd 212 live requests.
# NOTE: the production .env may still carry the RETRY_CB_MAX_REQUEUES=1500 stop-gap
# from before the delayed requeue shipped — remove that line, the count is no longer
# the policy and a hand-tuned value only hides a broken delay path.
RETRY_CB_MAX_REQUEUES=1000


# ------------------------------------------------------------
# Dynamic concurrency
# ------------------------------------------------------------
ORACLE_CONCURRENCY_MIN=5
ORACLE_CONCURRENCY_MAX=10
API_CONCURRENCY_MIN=5
API_CONCURRENCY_MAX=10
CONCURRENCY_MONITOR_INTERVAL=10000
CONCURRENCY_SCALE_UP=50
CONCURRENCY_SCALE_DOWN=10
CONCURRENCY_SCALE_STEP=2
CONCURRENCY_COOLDOWN=30000
CONCURRENCY_ALLOW_RESTART=false
THREAD_POOL_MULTIPLIER=2
THREAD_POOL_QUEUE=50


# ------------------------------------------------------------
# Tomcat tuning
# ------------------------------------------------------------
TOMCAT_ACCEPT_COUNT=1000
TOMCAT_MAX_CONNECTIONS=10000
TOMCAT_CONNECTION_TIMEOUT=20s
TOMCAT_MAX_THREADS=2000


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# DEBUG is the yaml default; prefer INFO in production so request payloads
# do not end up in gateway.log (which the ops console streams over SSE).
LOG_LEVEL=INFO


# ============================================================
# OPS SIDECAR (separate JVM, :8092 — ops/qosid-ops.service)
# ============================================================
OPS_PORT=8092
OPS_GATEWAY_HEALTH_URL=http://localhost:8090/qosid/admin/api/health
# The start command MUST be a command that EXITS (systemctl start ...),
# never a foreground `java -jar` — the sidecar would hold the child forever.
# The service user needs a scoped sudoers entry for exactly these two.
OPS_GATEWAY_START_COMMAND=/usr/bin/systemctl start gateway-service
OPS_GATEWAY_STOP_COMMAND=/usr/bin/systemctl stop gateway-service
OPS_LOG_FILE=/opt/services/qosid-flow/logs/gateway.log
# Same H2 database as SETTINGS_DB_PATH above (shared via AUTO_SERVER).
OPS_SETTINGS_DB_PATH=/opt/services/qosid-flow/data/settings
# The ops unit ALSO needs SETTINGS_ENCRYPTION_KEY (identical value) for
# stop-to-edit writes of secret-typed settings.
